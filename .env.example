# Local NotebookLM — example environment file.
# Copy to `.env` and adjust. The real .env is gitignored and never committed.
# NOTE: This file contains ONLY placeholders. Do not put real secrets here.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Network visibility. 127.0.0.1 = local only (recommended).
# 0.0.0.0 = reachable by every device on your LAN — exposes the UI AND the
# server file browser, with no login. Only set 0.0.0.0 on a network you trust.
MMRAG_HOST=127.0.0.1
MMRAG_PORT=8008

# Directory where all local data lives (sources copies, vectorstore, cache).
# Relative to the project root by default. This directory is gitignored.
MMRAG_DATA_DIR=data

# UI language (en | de).
MMRAG_LANGUAGE=en

# Colored terminal output for vellum's own banners (1 | 0). NO_COLOR also disables it.
MMRAG_COLOR=1

# ---------------------------------------------------------------------------
# CLI bridge — which local coding/agent CLI answers chat requests.
# One of: claude-code | hermes | codex | command
# ---------------------------------------------------------------------------
MMRAG_CLI_ADAPTER=claude-code

# Optional default model id passed to the adapter as `--model`. The web UI's
# model picker overrides this per chat. Available ids: server/model_catalog.py.
# MMRAG_MODEL=claude-opus-4-8

# For the generic "command" adapter only: the executable to invoke.
# The prompt is passed on stdin; the answer is read from stdout.
# Example placeholder (replace with your own command):
# MMRAG_CLI_COMMAND=my-llm-cli --stdin

# Optional per-adapter overrides (leave blank to use the adapter default):
# MMRAG_CLAUDE_BIN=claude
# MMRAG_HERMES_BIN=hermes
# MMRAG_CODEX_BIN=codex

# Seconds to wait for the CLI to answer before timing out.
MMRAG_CLI_TIMEOUT=120

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# One of: sentence-transformers | hashing
# "hashing" needs no extra dependencies (good for testing / minimal installs).
# "sentence-transformers" gives real semantic search (heavier install).
MMRAG_EMBEDDER=hashing

# Model name when MMRAG_EMBEDDER=sentence-transformers
MMRAG_ST_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Audio transcription (optional)
# ---------------------------------------------------------------------------
# One of: faster-whisper | whisper | disabled
MMRAG_TRANSCRIBER=disabled
# Whisper model size when transcription is enabled (tiny|base|small|medium|large)
MMRAG_WHISPER_MODEL=base

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
MMRAG_TOP_K=6
MMRAG_CHUNK_SIZE=1000
MMRAG_CHUNK_OVERLAP=150
