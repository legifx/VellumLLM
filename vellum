#!/usr/bin/env bash
# Vellum launcher (macOS/Linux). Thin shim — all logic lives in vellum.py so the
# same behaviour runs on every platform. Windows uses vellum.cmd instead.
#   ./vellum            first run sets up, then starts; afterwards just starts
#   ./vellum init       guided setup     ./vellum ask -n <id> "q"   query one Vellum
#   ./vellum start      start the server ./vellum notebooks         list Vellums
#   ./vellum update     self-update      ./vellum doctor            check prereqs
#   ./vellum --help
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Pick a Python 3.10+ to bootstrap the launcher (it creates the venv itself).
for c in "${PYTHON:-}" python3.12 python3.11 python3.10 python3 python; do
  [ -n "$c" ] || continue
  if command -v "$c" >/dev/null 2>&1 && \
     "$c" -c 'import sys; sys.exit(0 if sys.version_info[:2] >= (3, 10) else 1)' 2>/dev/null; then
    exec "$c" "$ROOT/vellum.py" "$@"
  fi
done

echo "Vellum needs Python 3.10 or newer, but none was found." >&2
echo "Install it (e.g. 'sudo apt install python3.11') and try again." >&2
exit 1
