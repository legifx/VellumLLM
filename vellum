#!/usr/bin/env bash
# Vellum — one command to set it up and run it.
#
#   ./vellum              first run sets up, then starts; afterwards just starts
#   ./vellum init         (re)run the guided setup        (flags: --reconfigure, --yes, ...)
#   ./vellum start        start the local server
#   ./vellum doctor       check prerequisites
#   ./vellum --help
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
VENV="$ROOT/.venv"

# --- pick a Python (3.10+) ------------------------------------------------
pick_python() {
  if [ -n "${PYTHON:-}" ]; then echo "$PYTHON"; return; fi
  for c in python3.12 python3.11 python3.10 python3; do
    if command -v "$c" >/dev/null 2>&1; then
      "$c" - <<'PY' >/dev/null 2>&1 && { echo "$c"; return; }
import sys; sys.exit(0 if sys.version_info[:2] >= (3, 10) else 1)
PY
    fi
  done
  return 1
}

require_python() {
  if ! PY="$(pick_python)"; then
    echo "Vellum needs Python 3.10 or newer, but none was found." >&2
    echo "Install it (e.g. 'sudo apt install python3.11') and try again." >&2
    exit 1
  fi
}

# --- ensure venv + core deps for running the server -----------------------
ensure_runtime() {
  require_python
  if [ ! -d "$VENV" ]; then
    echo "Creating virtualenv (.venv)…"
    "$PY" -m venv "$VENV"
  fi
  # shellcheck disable=SC1091
  source "$VENV/bin/activate"
  if ! python -c "import fastapi, uvicorn" >/dev/null 2>&1; then
    echo "Installing core dependencies…"
    pip install -q --upgrade pip
    pip install -q -r requirements.txt
  fi
  [ -d "$ROOT/.git" ] && bash "$ROOT/scripts/install-hooks.sh" >/dev/null 2>&1 || true
}

cmd_doctor() {
  require_python
  echo "Python:  $("$PY" --version 2>&1)  ($PY)"
  if command -v ffmpeg >/dev/null 2>&1; then
    echo "ffmpeg:  $(ffmpeg -version 2>&1 | head -1 | cut -d' ' -f1-3)  (audio/video ready)"
  else
    echo "ffmpeg:  not found  (only needed for audio/video ingestion)"
  fi
  if [ -f "$ROOT/.env" ]; then echo "Config:  .env present"; else echo "Config:  not set up yet — run ./vellum init"; fi
}

cmd_init() { require_python; "$PY" -m server.onboarding "$@"; }

cmd_start() {
  ensure_runtime
  exec python -m server.main
}

cmd_help() {
  # print the leading comment block (after the shebang), stripped of '# '
  awk 'NR>1 && /^#/{sub(/^# ?/,"");print; next} NR>1{exit}' "$ROOT/vellum"
}

# --- dispatch -------------------------------------------------------------
case "${1:-}" in
  init)            shift; cmd_init "$@" ;;
  start)           shift; cmd_start ;;
  doctor)          shift; cmd_doctor ;;
  -h|--help|help)  cmd_help ;;
  "")
    if [ ! -f "$ROOT/.env" ]; then cmd_init; fi
    cmd_start
    ;;
  *) echo "Unknown command: $1" >&2; cmd_help; exit 2 ;;
esac
